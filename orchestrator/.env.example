# Required only for non-dry-run GitHub issue/PR operations.
GITHUB_TOKEN=

# Optional reviewer API keys. Tests and dry-run modes do not require them.
OPENAI_API_KEY=
OPENAI_REVIEWER_MODEL=gpt-5
OPENAI_SUPERVISOR_MODEL=gpt-5
ANTHROPIC_API_KEY=

# Optional local executor command. Leave unset for safe stubs.
CODEX_CLI_COMMAND=codex

# Optional safety timeout for local-loop Codex executions, configured in YAML.
CODEX_EXECUTOR_TIMEOUT_SECONDS=1800
